# Required at build time. Better Auth uses this backend origin with /api/auth.
# Render production: https://api-fitai.viniciusbsouto.com.br
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Server-side flag: show Google only after configuring the backend provider.
GOOGLE_OAUTH_ENABLED=false
# TeamSocLo and Google client secrets belong exclusively to the backend.
